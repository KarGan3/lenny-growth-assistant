# Frontend environment (Vite). Copy to .env for local overrides.
#
# When true, the UI runs entirely on in-memory mock data with simulated
# streaming — no backend required. Set to false once the FastAPI backend is up.
VITE_USE_MOCK=false

# Base path the frontend calls. Leave as /api; Vite (dev) and nginx (prod)
# proxy it to the FastAPI backend, so you never hardcode host/port here.
VITE_API_BASE_URL=/api

# Dev-only: where Vite proxies /api to when running `npm run dev`.
VITE_PROXY_TARGET=http://127.0.0.1:8000
