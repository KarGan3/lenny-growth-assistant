DATABASE_URL=postgresql+psycopg://lenny@127.0.0.1:5433/lenny_growth_assistant
# DATABASE_URL=sqlite:///./data/app.db   # local-dev fallback, no setup required

LLM_PROVIDER=ollama            # anthropic | openai | ollama  (ollama is mandatory for the submitted demo)
LLM_FALLBACK_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

RAG_PERSIST_DIR=./data/chroma
RAG_EMBEDDER=local-lexical        # onnx-minilm | ollama | local-lexical
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.15

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=512
RAG_MAX_CONTEXT_CHARS=8000
OLLAMA_CONTEXT_LENGTH=8192

# Long-form writing uses a separate budget; CPU essays can take several minutes.
CONTENT_MAX_OUTPUT_TOKENS=2400
# Short document routes aim for 300–450 words and use a smaller generation cap.
DOCUMENT_MAX_OUTPUT_TOKENS=800
CONTENT_TIMEOUT_SECONDS=600
# Lower randomness favors faithful synthesis over creative variations.
LLM_TEMPERATURE=0.2
# Assignment demo is transcript-only. Opt-in general replies are labeled and produce no artifacts.
ALLOW_GENERAL_KNOWLEDGE=false
# Local CPU evidence checking; setup.sh installs these pinned public weights.
EVIDENCE_MODEL_DIR=.local/evidence
EVIDENCE_MIN_ENTAILMENT=0.6
